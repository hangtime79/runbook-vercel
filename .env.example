# Optional — enables the "Ask the analysis" Q&A tab in the Streamlit dashboard.
# Every other tab (Narrative, Key Findings, Fraud Patterns, Detection Model,
# Data Explorer) works without it; the Q&A tab simply shows a notice until a key
# is present.
#
# To enable it, get a key at https://console.anthropic.com/ and copy this file:
#   cp .env.example .env
# then paste your key after the '=' below. .env is gitignored — your key stays local.
ANTHROPIC_API_KEY=
