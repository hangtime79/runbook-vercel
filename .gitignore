__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/
.streamlit/

# Per-run outputs — regenerated by the orchestration, not part of the pattern
archive/
scripts/
artifacts/

# Global Claude env symlink
.claude/global

# Observability event log — session-scoped, not part of the pattern
.claude/observability/

# Runtime logs — produced when the dashboard runs, not part of the pattern
nohup.out
streamlit.log
*.log

# Secrets
.env
